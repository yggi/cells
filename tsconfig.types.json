{
  // The declarations a consumer typechecks against (`types/`, committed; `npm run types` writes them, a test fails when
  // they are stale): a frontend with stricter settings than these reads the language's types, not its sources.
  "extends": "./tsconfig.pure.json",
  "compilerOptions": { "noEmit": false, "declaration": true, "emitDeclarationOnly": true, "rootDir": "src", "outDir": "types" }
}
