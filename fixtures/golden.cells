&piece title="Golden reference" tags="basics" label="One of every kind of wheel and edge, in one graph: the gallery's reference picture." about=&out
# time, and the tables a melody reads
&bar scan(27 23 26 24) step=free(96bpm, 60..160)
&key shift=free(0, -6..6)
&mode over=&key scan(2 2 1 2 2 2 1)
&blues scan(3 2 1 1 3 2)
&alpha cycle=9 map=ed(3/2)
# melodies, a pattern of levels, a slow wobble
&up 0 0 4 4 5 5 4@2
&theme over=&mode step=&bar 0 2 4 7 4 2 0@2
&tune over=scale(0,5) step=96bpm show=do &up &up
&walk over=&blues step=96bpm 0 1 2 3
&drone over=&alpha step=48bpm 0 3 6
&line step=96bpm show=notes 12 11 12@2 7@2 8@2
&accent map=amp step=&bar/4 1 .4 .8 .4
&vibrato map=lin loop=6 0 .3 0 -.3 0
# voices
&flute s=tri loop=C4 room=.3 env=&(map=adsr .02 .3 .5 .3)
&lead s=tri loop=C5 env=&(map=adsr .01 .3 .4 .3)
&hh s=white hpf=7000 env=&(map=adsr 0 .04 0 .02)
# two instruments, and the matrix that picks between them
&leadA [&walk * &lead * .3]
&leadB [&drone * &lead * .3]
&parts &leadA &leadB
&tetris over=&parts step=3bpm [0,1] [1] [0]
# a motor with a belt, a tape it turns, a fork that rings
&capstan scan(1 1 1 1) step=96bpm motor=1.4 mass=1 friction=.1 wow=.015 varispeed=1
&hats step=&capstan/2 belt=30 mass=1.5 ~ 0 ~ 0 ~ 0 ~ 0
&motif over=&mode step=192bpm 0 ~ 4 ~ 7 ~!3 11 ~ 9
&tape step=&capstan write=&motif length=6 erase=.45 varispeed=1
&near play=&tape at=.375
&hits step=24bpm 1 ~ ~ ~
&forkA body=fork loop=A4 ring=10 hard=.35 board=none 0
# the day, and a scope on the voice
&cycle law=fiveto12 anchor=11.55 step=84bpm
&sun sun=&cycle
&light scope=spectrum &flute
&out level=4 loop=SAMPLE_RATE map=sample [(&theme + &vibrato) * &accent * &flute * .4, &tune * &lead * .3, &line * &lead * .2, &near * &flute * .1, &motif * &lead * .2, &cycle * &flute * .2] [&tetris, &hits * &forkA * .5, &hats * &hh * .1]
