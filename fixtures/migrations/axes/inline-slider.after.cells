# an unnamed style in order, its articulation left to a slider: bite takes the slider (decision 076, #572)
&bar meter("4/4") step=120bpm
&style style=&(map=style sync=.5 harm=.75 bite=free(.35, 0..1) mood=.5)
&line step=2n 0 4
&keysV s=tri loop=C3 lpf=400..2400 * &style[bite]
&out map=sample [&line * &keysV]
