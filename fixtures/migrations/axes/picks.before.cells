# a style by name on the old axes, read by a voice through picks of [artic] and [energy] (decision 076, #572)
&bar meter("4/4") step=120bpm
&mine map=style sync=1 harm=.12 artic=.85 energy=.75
&style style=&mine
&line step=4n 0 2 4 7
&leadV s=tri..square * &style[artic] loop=C4 lpf=1400..3600 * &style[energy]
&out map=sample [&line * &leadV * .5]
