# a style written in order on the axes before v0.22.0, sync harm artic energy; the bass's cutoff reads its third (decision 076, #572)
&bar meter("4/4") step=120bpm
&funk map=style sync=.3 harm=.45 drive=.55 bright=.25
&style style=&funk
&line step=1m 0 3
&bassV s=saw loop=C2 lpf=300..1200 * &style[$2]
&out map=sample [&line * &bassV]
