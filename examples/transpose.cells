&piece title="Key and mode: one theme, two wheels" tags="tutorial, genre:classical, modal, diatonic, harmony" rung=5 label="One theme, read through a mode and a key." about=&mix
&turnNote label="Turn either, and the theme follows." about=(&key &mode)
# The mechanism on its own: a theme read through two wheels.
# Change shift= on &key or &mode — the theme follows.
&bar scan(1 1 1 1) step=96bpm

&key label="key: **{tonic}**" shift=2 size=1.5                # the 12, turned two: D. Turning it transposes
&mode label="**{mode}** on {tonic}: {notes}" over=&key scan(2 2 1 2 2 2 1) shift=1   # turned one: it walks the modes
&theme label="the theme: {notes}" show=notes over=&mode step=&bar 0 2 4 7 4 2 0@2

&flute s=tri loop=C4 room=.3 env=&(map=adsr .02 .3 .5 .3)
&mix level=6.5 map=sample [&theme * &flute]
