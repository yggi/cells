&piece title="Drunken Sailor: D Dorian, with a kit" tags="genre:world, genre:folk, modal, rhythm" label="Drunken Sailor in D Dorian, with a fiddle, a bass and a drum kit." about=&mix
# D Dorian. The second line is the first, a step lower: degree(&A, -1).
&bar scan(1 1 1 1) step=free(112bpm, 90..140)
&dorian over=scale(2,3)

&m1 4!4
&m2 4 4 0 2
&m3 3 2 0 0
&m4 0@2!2
&A &m1 &m2
&C &m3 &m4
&tune over=&dorian step=&bar/2 &A degree(&A, -1) &A &C

&bassline over=&dorian step=&bar 4!4 3!4
&drums step=&bar/2 &bd &hh &sd &hh!4       # kick, hat, snare, hat

&fiddle s=saw loop=C5 lpf=3000 env=&(map=adsr .01 .15 .5 .1)
&bass s=square loop=C2 lpf=600 env=&(map=adsr .005 .25 0 .05)
&bd s=sine loop=A1 pitch=0..24 * &(map=adsr 0 .05 0 0) env=&(map=adsr 0 .3 0 .05)
&sd s=white hpf=1500 env=&(map=adsr 0 .12 0 .04)
&hh s=white hpf=7000 env=&(map=adsr 0 .04 0 .02)
&mix level=5 map=sample [&tune * &fiddle * 0.6, &bassline * &bass * 0.8, &drums * 0.6]
