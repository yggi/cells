&piece title="Arrangement: parts and a song" tags="tutorial, arrangement" rung=15 label="Three parts, and a song that picks which of them play: an intro, a verse, a chorus, an end." about=&out
&partsNote label="A part is a mix with a name. &parts lists them; &song reads it, a section a step: a number picks one part, a chord several." about=(&parts &song)
&lapsNote label="laps=1: the song plays once, then ends. off switches a cell off, and everything that plays it: take it from &click to hear the beat." about=&song
&bar scan(1 1 1 1) step=free(moderato)
&major scale(major)

&chords over=&major step=&bar*4 [0,2,4] [3,5,7] [4,6,8] [0,2,4]
&tune over=&major step=&bar/2 4 4 5 7 7 5 4 2 0 0 2 4 4@2 2@2
&kick step=&bar 0 ~ 0 ~
&click off step=&bar 12 0 0 0                     # a click on the beat, switched off

&keys s=tri loop=C4 env=&(map=adsr .01 .5 .3 .3)
&lead s=square loop=C5 lpf=2500 env=&(map=adsr .01 .2 .5 .2)
&rim s=sine loop=E5 env=&(map=adsr 0 .03 0 .02)
&bd s=sine loop=A1 pitch=0..24 * &(map=adsr 0 .04 0 0) env=&(map=adsr 0 .3 0 .05)

&keysPart [&chords * &keys * .15]
&tunePart [&tune * &lead * .2]
&drumPart [&kick * &bd * .6,         # a long line can go on: it ends with a comma
           &click * &rim * .1]
&parts &keysPart &tunePart &drumPart
&song over=&parts step=&bar*16 laps=1 label="intro · verse · chorus · end" 0 [0,2] [0,1,2] 0
&out map=sample level=6 &song
