{
  "name": "@yggi/cells",
  "version": "0.10.0",
  "description": "The cells language: parse, compile, realize, the headless engine, Shorten, the folder (MIDI to cells).",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "module": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./engine/*": {
      "types": "./types/engine/*.d.ts",
      "module": "./src/engine/*.ts",
      "default": "./dist/engine/*.js"
    },
    "./theory/*": {
      "types": "./types/theory/*.d.ts",
      "module": "./src/theory/*.ts",
      "default": "./dist/theory/*.js"
    },
    "./repository/*": {
      "types": "./types/repository/*.d.ts",
      "module": "./src/repository/*.ts",
      "default": "./dist/repository/*.js"
    },
    "./examples/*": "./examples/*",
    "./fragments/*": "./fragments/*",
    "./midi/*": "./midi/*",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "!src/**/*.test.ts",
    "dist",
    "types",
    "examples",
    "fragments",
    "docs/language",
    "midi",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "test": "vitest run --project quick",
    "test:all": "vitest run",
    "test:slow": "vitest run --project slow",
    "check": "tsc -p tsconfig.types.json --incremental --tsBuildInfoFile .cache/types.tsbuildinfo --outDir .cache/types && tsc -p tsconfig.json --incremental --tsBuildInfoFile .cache/tsconfig.tsbuildinfo && node tools/strict.mjs",
    "lint": "eslint --cache --cache-strategy content --cache-location .cache/eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check --cache --cache-strategy content --cache-location .cache/prettier .",
    "knip": "knip",
    "examples": "node --experimental-strip-types --no-warnings tools/examples.ts",
    "fragments": "node --experimental-strip-types --no-warnings tools/fragments.ts",
    "preverify": "node tools/install-first.mjs && sh tools/verified.sh begin",
    "verify": "npm run check && npm run lint && npm run format:check && npm run knip && npm test -- --reporter=default --reporter=./tools/test-count.ts",
    "postverify": "sh tools/verified.sh end",
    "reference": "node --experimental-transform-types --import ./tools/node-ts.mjs tools/reference.ts",
    "normalise": "node --experimental-transform-types --import ./tools/node-ts.mjs tools/normalise.ts",
    "structure": "node --experimental-transform-types --no-warnings --import ./tools/node-ts.mjs tools/structure.ts",
    "types": "tsc -p tsconfig.types.json",
    "dist": "node --experimental-strip-types --no-warnings tools/dist.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "knip": "^6.40.0",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=22"
  }
}
