{
  "name": "@yggi/cells",
  "version": "0.4.0",
  "description": "The cells language: parse, compile, realize, the headless engine, Shorten, the folder (MIDI to cells).",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./src/index.ts"
    },
    "./engine/*": {
      "types": "./types/engine/*.d.ts",
      "default": "./src/engine/*.ts"
    },
    "./theory/*": {
      "types": "./types/theory/*.d.ts",
      "default": "./src/theory/*.ts"
    },
    "./repository/*": {
      "types": "./types/repository/*.d.ts",
      "default": "./src/repository/*.ts"
    },
    "./examples/*": "./examples/*",
    "./midi/*": "./midi/*",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "!src/**/*.test.ts",
    "types",
    "examples",
    "docs/language",
    "midi",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "test": "vitest run --project quick",
    "test:all": "vitest run",
    "test:slow": "vitest run --project slow",
    "check": "tsc -p tsconfig.pure.json && tsc -p tsconfig.json && node tools/strict.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "knip": "knip",
    "examples": "node --experimental-strip-types --no-warnings tools/examples.ts",
    "preverify": "sh tools/verified.sh begin",
    "verify": "npm run check && npm run lint && npm run format:check && npm run knip && npm test -- --reporter=default --reporter=./tools/test-count.ts",
    "postverify": "sh tools/verified.sh end",
    "reference": "node --experimental-transform-types --import ./tools/node-ts.mjs tools/reference.ts",
    "types": "tsc -p tsconfig.types.json"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "knip": "^6.40.0",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=22"
  }
}
